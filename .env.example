# Optional Google AI Studio key for generated plans. Keep this on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Private Vercel Blob store for reviewer links and planner rate limits.
# Vercel supplies BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID and its OIDC token when linked.
BLOB_READ_WRITE_TOKEN=
