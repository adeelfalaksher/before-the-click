# Supabase (public browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Must match btc_private.server_configuration.secret in the dedicated Supabase project
BTC_SERVER_SECRET=YOUR_WORKFLOW_SIGNING_SECRET
APP_URL=https://before-the-click.vercel.app
# Server-only AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional free fallback for AI drafting. Set both values to enable it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional Google account integrations: do not enable until OAuth is configured and authorized
GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://before-the-click.vercel.app/api/integrations/google/callback
# Existing private review storage for older review links
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_TOKEN
